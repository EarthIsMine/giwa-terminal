# 체인 파라미터 — 전부 주입식 (절대 규칙 4)
# 프라이빗 메인넷 초대 시 이 값들만 교체하면 즉시 재싱크된다.
# 미설정 시 config/chains.ts 의 GIWA Sepolia 기본값을 사용한다.

NEXT_PUBLIC_GIWA_CHAIN_ID=91342
NEXT_PUBLIC_GIWA_CHAIN_NAME="GIWA Sepolia"
NEXT_PUBLIC_GIWA_RPC_URL=https://sepolia-rpc.giwa.io
NEXT_PUBLIC_GIWA_EXPLORER_URL=https://sepolia-explorer.giwa.io

# 아래는 컨트랙트 배포 후 채운다 (인덱서/API 단계에서 사용)
