# 체인 파라미터 — 전부 주입식 (절대 규칙 4)
# 프라이빗 메인넷 초대 시 이 값들만 교체하면 즉시 재싱크된다.
# 미설정 시 config/chains.ts 의 GIWA Sepolia 기본값을 사용한다.

NEXT_PUBLIC_GIWA_CHAIN_ID=91342
NEXT_PUBLIC_GIWA_CHAIN_NAME="GIWA Sepolia"
NEXT_PUBLIC_GIWA_RPC_URL=https://sepolia-rpc.giwa.io
NEXT_PUBLIC_GIWA_EXPLORER_URL=https://sepolia-explorer.giwa.io
NEXT_PUBLIC_GIWA_BRIDGE_URL=https://sepolia-bridge.giwa.io

# 아래는 컨트랙트 배포 후 채운다 (인덱서/API 단계에서 사용)
# NEXT_PUBLIC_GIWA_FACTORY_ADDRESS=
# NEXT_PUBLIC_GIWA_ROUTER_ADDRESS=
# NEXT_PUBLIC_GIWA_TOKEN_FACTORY_ADDRESS=
# NEXT_PUBLIC_GIWA_IDENTITY_REGISTRY_ADDRESS=
# NEXT_PUBLIC_GIWA_START_BLOCK=
# WETH는 OP Stack 프리디플로이 기본값(0x4200...0006) 사용 — 다른 체인에서만 교체
# NEXT_PUBLIC_GIWA_WETH_ADDRESS=
# 도장(Dojang) Verified Address 조회 — 기본값은 GIWA Sepolia 공개 주소.
# 메인넷 주소는 미공개(기와팀 공개 시 여기로 주입 — CLAUDE.md 제품 결정)
# NEXT_PUBLIC_GIWA_DOJANG_SCROLL_ADDRESS=
# NEXT_PUBLIC_GIWA_UPBIT_ATTESTER_ID=

# --- packages/indexer (Ponder) ---
# 인덱서 전용 RPC — 공개 RPC는 레이트리밋이 있어 Nodit 등 전용 엔드포인트 권장.
# 미설정 시 NEXT_PUBLIC_GIWA_RPC_URL 폴백.
# GIWA_INDEXER_RPC_URL=
# 프로덕션 DB (Railway Postgres 등). 로컬 dev는 미설정 시 내장 PGlite 사용.
# DATABASE_URL=
# ponder start(프로덕션)는 배포마다 고유 스키마 필요 — Railway에선 RAILWAY_DEPLOYMENT_ID 활용
# DATABASE_SCHEMA=

# --- apps/web → 인덱서 API (서버 전용, 미설정 시 차트·체결 자리표시 유지) ---
# INDEXER_URL=http://localhost:42069

# --- 서버 전용 RPC (Nodit 등 키 포함 엔드포인트) ---
# 주의: NEXT_PUBLIC 접두사 금지 — 붙이면 클라이언트 번들·유저 지갑에 키가 노출된다.
# 미설정 시 공개 RPC(NEXT_PUBLIC_GIWA_RPC_URL) 폴백.
# GIWA_SERVER_RPC_URL=

# --- scripts/seed 시드 봇 전용 RPC ---
# 상시 가동 봇은 공개 RPC 레이트리밋의 최대 소비자가 된다 — 전용 엔드포인트 권장.
# SEED_RPC_URL=

# --- packages/contracts 배포용 (forge script) ---
# 배포 지갑 키 — 봇 지갑과 분리, 절대 커밋 금지 (CLAUDE.md 보안 규칙)
# DEPLOYER_PRIVATE_KEY=
# GIWA_RPC_URL=https://sepolia-rpc.giwa.io
# WETH_ADDRESS=
# 스모크 스크립트용 (배포 출력값)
# TOKEN_FACTORY_ADDRESS=
# ROUTER_ADDRESS=
